# ---------------------------------------------------------------------------
# LearnForge configuration. Copy to .env (compose) or backend/.env (local dev).
# Every value has a safe offline default - the app runs with ZERO API keys.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=21001
DATABASE_URL=postgresql://learnforge:learnforge@localhost:21010/learnforge
REDIS_URL=redis://localhost:21011
APP_URL=http://localhost:21000
API_PUBLIC_URL=http://localhost:21001
# Extra comma-separated origins allowed by CORS / Socket.IO (APP_URL is always allowed)
CORS_ORIGINS=
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=300
UPLOAD_MAX_MB=10
# Seed demo data when the API container starts (idempotent)
SEED_ON_START=true

# --- Auth ---------------------------------------------------------------------
# REQUIRED in production: long random string (>= 24 chars), e.g. `openssl rand -base64 48`
JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# One-click demo logins + local dev mailbox for magic links (disable in production!)
DEV_LOGIN_ENABLED=true
# OAuth (optional; buttons appear when both id and secret are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AI -----------------------------------------------------------------------
# fake (offline, deterministic) | anthropic | openai | gemini | ollama
LLM_PROVIDER=fake
# Model override; defaults: anthropic=claude-opus-5-5, openai=gpt-4.1-mini, gemini=gemini-2.5-flash, ollama=llama3.1
LLM_MODEL=
# Optional separate model for the LLM-as-judge quality gate
JUDGE_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# hash (offline feature-hashing, 256-d) | openai (text-embedding-3-small @ 256-d)
EMBEDDING_PROVIDER=hash
# fsrs | sm2
SRS_ALGORITHM=fsrs

# --- Code sandbox ---------------------------------------------------------------
# quickjs (in-process WASM, JavaScript) | piston (docker compose --profile sandbox, JS + Python)
SANDBOX_PROVIDER=quickjs
PISTON_URL=http://localhost:21020
SANDBOX_TIMEOUT_MS=2000

# --- Billing ------------------------------------------------------------------------
# mock (no keys, same state machine) | stripe
BILLING_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
FREE_GENERATIONS_PER_MONTH=10
PRO_GENERATIONS_PER_MONTH=500

# --- Frontend (build-time) ---------------------------------------------------------
API_INTERNAL_URL=http://localhost:21001
NEXT_PUBLIC_WS_URL=http://localhost:21001
