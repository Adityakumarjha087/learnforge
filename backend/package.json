{
  "name": "@learnforge/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test prisma",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "openapi": "tsx src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.128",
    "@ai-sdk/openai": "^4.0.125",
    "@ai-sdk/openai-compatible": "^3.0.96",
    "@anthropic-ai/sdk": "^1.14.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@prisma/client": "^6.19.3",
    "@trpc/server": "^11.31.3",
    "ai": "^7.0.183",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "ioredis": "^6.1.0",
    "jose": "^6.2.18",
    "pino": "^10.4.0",
    "quickjs-emscripten": "^0.32.0",
    "socket.io": "^4.8.4",
    "stripe": "^23.2.0",
    "superjson": "^2.2.7",
    "unpdf": "^2.2.2",
    "zod": "^4.6.7",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.4",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  }
}
